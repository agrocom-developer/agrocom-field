#!/usr/bin/env bash
#
# Ciclo de desarrollo continuo — el bucle que sigue solo hasta que se le diga
# que pare.
#
#   bin/ciclo                  # en primer plano, encadenando tareas
#   bin/ciclo --fondo          # se desprende de la terminal: cerrar la ventana ya no lo mata
#   bin/ciclo --detener        # parada ordenada: termina lo que está haciendo y no toma otra tarea
#   bin/ciclo --reanudar       # levanta la bandera de parada
#   bin/ciclo --estado         # en qué fase de qué tarea está
#   bin/ciclo --planificar 08  # planifica lo que sigue a la 08, si esa vuelta se cortó
#   bin/ciclo --vueltas 2      # tope de tareas en esta corrida (por defecto, hasta que se detenga)
#   bin/ciclo --reconciliar    # corrige los runs/*.estado que git desmiente (--simular para ver nomás)
#
# Espejo exacto, en mecánica, del `bin/ciclo` de `agrocom-api` (mismo dueño,
# misma filosofía de fondo, ver `docs/gestion/automatizacion_desarrollo.md`
# de este repo para el porqué de un proceso aparte) — corre una cola que se
# extiende sola: cuando una tarea queda integrada, una sesión de
# planificación lee el backlog y escribe el prompt de la siguiente.
#
# Cinco fases por tarea, cada una en su propia sesión de Claude Code con
# contexto limpio:
#
#   implementar → verificar → abrir PR → esperar CI → planificar la siguiente
#
# **Una tarea = una HU o TE completa = un PR.** La fase de implementación no es
# una sola sesión: encadena hasta `etapas=` sesiones sobre la MISMA rama, cada
# una retomando donde quedó la anterior. La sesión declara `PARCIAL` mientras
# la historia siga abierta y `OK` recién cuando esté entera; el PR se abre al
# `OK`, con todos los commits acumulados adentro. La unidad de entrega la fija
# el plan de sprints, no el tamaño de una sesión.
#
# La rama tampoco la elige la sesión: la crea el ciclo, desde el metadato
# `rama=` del prompt. Y el prompt de la tarea siguiente, que escribe la
# planificación, viaja como primer commit de la rama de esa misma tarea.
#
# **Una tarea trabada no corta el bucle.** Queda marcada en `runs/NN.estado` y,
# si tenía trabajo hecho, en un PR en borrador; el ciclo planifica igual y
# sigue con la próxima. Lo único que lo detiene es una parada pedida, que se
# acabe la cola, o TAREAS_TRABADAS seguidas sin integrar — que ya no es una
# tarea difícil sino algo sistemático. Va a chocar seguido con tareas que no
# califican (dependen de una decisión sin tomar, o necesitan al usuario
# presente), y frenar el turno entero por eso dejaría el backlog parado por
# una fila que nunca iba a poder tomar.
#
# El estado no vive en ninguna conversación: vive en git (ramas, commits, PRs)
# y en runs/, que se puede auditar después. Por eso el ciclo se puede matar en
# cualquier punto y retomar.
#
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
mkdir -p runs

COLA=runs/cola.txt
DETENER=runs/DETENER
BITACORA=runs/ciclo.log
PID=runs/ciclo.pid

ETAPAS_IMPL=5        # sesiones encadenadas sobre la misma rama para terminar una HU
FALLOS_IMPL=3        # sesiones SEGUIDAS sin estado declarado antes de rendirse
TAREAS_TRABADAS=${AGROCOM_TAREAS_TRABADAS:-3}   # tareas SEGUIDAS sin integrarse antes de parar el bucle entero
INTENTOS_ARREGLO=2   # vueltas de corrección tras un veredicto RECHAZADO o un CI en rojo

# Tope de espera de CI. Este repo no tiene todavía una serie de corridas
# propia para calibrarlo (es la primera vez que corre el ciclo), así que
# arranca con el mismo orden de magnitud medido en `agrocom-api` — tres veces
# un CI lento, no diez: un tope demasiado generoso no es holgura, es ceguera
# ante un PR que quedó en conflicto y nunca va a tener CI. Ajustable sin
# tocar el script vía `AGROCOM_ESPERA_CI` en cuanto haya corridas reales de
# `flutter-tests` para calibrar contra.
ESPERA_CI=${AGROCOM_ESPERA_CI:-900}
SONDEO_CI=20

# Una caída de red mata la sesión headless antes de que llegue a escribir
# runs/NN.estado: el modelo no falló, se quedó sin API. El corte se reconoce,
# no se cuenta como fallo de la tarea, y el ciclo espera a que la red vuelva
# en vez de quemar los reintentos contra un cable desconectado.
SONDA_RED=${AGROCOM_SONDA_RED:-https://api.anthropic.com/}
ESPERA_RED=${AGROCOM_ESPERA_RED:-1800}   # cuánto espera a que vuelva antes de darse por vencido
SONDEO_RED=30
CORTES_MAX=5         # cortes de entorno en la misma tarea antes de admitir que el problema es el entorno

# El otro corte que no es culpa de la tarea: el límite de uso de la cuenta. La
# hora de reposición viene en el propio mensaje de error ("resets 5:20pm"): el
# ciclo la lee y duerme hasta entonces en vez de agotar tareas sanas contra un
# 429.
LIMITE_MAX=${AGROCOM_LIMITE_MAX:-21600}   # tope de espera: 6 h. Más que eso ya no es una ventana de uso
SONDEO_LIMITE=600                          # cada cuánto reintenta si no pudo leer la hora de reposición

# Un PR sin un solo check pasados estos segundos no está lento: no va a tener
# CI nunca. Es lo que pasa cuando la rama quedó en conflicto —sin merge ref no
# hay workflow— y es indistinguible de "todos los checks pendientes" si solo
# se miran los checks. Se corta acá en vez de esperar el tope entero.
SIN_CHECKS_MAX=180

# Lo único que puede estar sin commitear al arrancar una tarea: lo que dejó
# escrito la sesión de planificación de la vuelta anterior. Los globs los
# resuelve git, no el shell — por eso van entre comillas. `prompts/plantillas/`
# queda deliberadamente afuera: si alguien está editando una plantilla, eso es
# trabajo humano en curso y el ciclo tiene que abortar, no commitearlo.
PLANIFICACION=('prompts/[0-9][0-9]-*.md' 'docs/gestion/cola_tareas.md')

# --- Modelo por fase --------------------------------------------------
# El trabajo que decide algo —implementar, verificar, corregir hallazgos,
# elegir la próxima tarea— va en el modelo mediano; el repetitivo —leer un log
# de CI en rojo, reproducirlo con bin/verify y arreglar lo que rompió— va en
# el más chico. Mismo criterio que usa `agrocom-api`.
#
# Fable no se usa en ninguna fase: decisión del usuario.
#
# Un prompt puede pedir otro modelo con `modelo=` en su metadato — para una
# tarea crítica que convenga correr con más criterio, por ejemplo.
MODELO_PESADO=${AGROCOM_MODELO_PESADO:-sonnet}
MODELO_LIVIANO=${AGROCOM_MODELO_LIVIANO:-haiku}

# --- Herramientas de las sesiones que editan código -------------------
# Sin `Monitor` ni `ScheduleWakeup`, y a propósito: una sesión headless que
# pasa mucho tiempo sin llamar a una herramienta se cierra sola, y "dejo un
# Monitor y espero la notificación" no cuenta como actividad para eso — ya
# pasó en `agrocom-api` (ver el `bin/ciclo` de ese repo). Lo que sí funciona es
# esperar con llamadas Bash sucesivas de menos de 10 minutos cada una.
HERRAMIENTAS_IMPL="Read Edit Write Glob Grep Bash"
HERRAMIENTAS_PROHIBIDAS="Monitor ScheduleWakeup"

# Se le agrega al final del texto de toda sesión que corre `bin/verify`. NN se
# reemplaza por el id de la tarea (ver `pie_verify`).
#
# A diferencia de `agrocom-api` (Playwright ~20 min en Windows), `bin/verify`
# de este repo hoy solo corre `pub get` + codegen + formato + análisis + tests
# de Flutter — no hay etapa que se acerque al tope de 10 min de una llamada
# Bash. Se deja la receta igual, como red de seguridad para cuando el proyecto
# crezca, sin prometer una duración que hoy no es cierta.
PIE_VERIFY='---
## Sobre `./bin/verify` en esta máquina

Esta sesión es headless: **si pasan 10 minutos sin que llames a una
herramienta, la sesión se cierra sola**, sin que hayas escrito el estado. Por
eso no existen acá `Monitor` ni `ScheduleWakeup`, y "espero la notificación"
no es una opción.

Hoy `./bin/verify` debería terminar bien por debajo de ese tope. Si alguna vez
no fuera así (una etapa nueva que tarde), la receta que funciona es:

    nohup ./bin/verify > runs/NN-verify.log 2>&1 &   # una sola vez
    echo $! > runs/NN-verify.pid
    timeout 540 tail --pid=$(cat runs/NN-verify.pid) -f /dev/null; tail -5 runs/NN-verify.log

Repetí esa última línea, una llamada Bash cada vez, hasta que el log termine en
`✓ Cascada completa` o `✗ La cascada falló`. Nunca lances un segundo
`bin/verify` mientras hay uno corriendo.

**Nunca termines la sesión con `bin/verify` corriendo ni sin haber escrito
`runs/NN.estado`**: si no llegás, escribí `PARCIAL` y dejá en `runs/NN.md` qué
falta. Una sesión que termina sin estado cuenta como fallida, no como "sigo
después".'
pie_verify() { printf '%s' "$PIE_VERIFY" | sed "s/NN/$1/g"; }

# --- Salida ----------------------------------------------------------
# Con --fondo, nohup ya redirige stdout a la bitácora: duplicar con tee dejaría
# cada línea escrita dos veces.
eco()   { if [ "${CICLO_EN_FONDO:-0}" = "1" ]; then cat; else tee -a "$BITACORA"; fi; }
log()   { printf '\033[90m%s\033[0m %s\n' "$(date +%H:%M:%S)" "$1" | eco; }
ok()    { printf '\033[32m  ✓ %s\033[0m\n' "$1" | eco; }
malo()  { printf '\033[31m  ✗ %s\033[0m\n' "$1" | eco; }
aviso() { printf '\033[33m  ⊘ %s\033[0m\n' "$1" | eco; }

# Un aviso que además sale de la bitácora corrida. Lo que queda enterrado en un
# log de decenas de miles de líneas no sirve para tomar medidas a la mañana:
# runs/alertas.log junta solo lo que salió mal y no se resolvió solo.
alerta() {
    printf '\033[31m  ‼ %s\033[0m\n' "$1" | eco
    printf '%s  %s\n' "$(date '+%d/%m %H:%M')" "$1" >> runs/alertas.log
}
fase()  { printf '\n\033[1m── %s ──\033[0m\n' "$1" | eco; }

marcar() { printf '%s\n' "$1" > runs/ciclo.estado; log "$1"; }

# --- Banderas de control ---------------------------------------------
detencion_pedida() { [ -f "$DETENER" ]; }

# La parada se chequea entre fases, nunca en medio de una: cortar una sesión a
# la mitad deja el working tree sucio y la tarea siguiente no puede arrancar.
abortar_si_detenido() {
    detencion_pedida || return 1
    aviso "Parada pedida: $(cat "$DETENER" 2>/dev/null | head -1)"
    return 0
}

# --- Metadatos del prompt --------------------------------------------
# Cada prompt declara en su primera línea cómo debe tratarse la tarea:
#   <!-- ciclo: critica=no turno-noche=1 rama=feature/sync-idempotente -->
meta() {
    local archivo="$1" clave="$2" defecto="$3" valor
    valor=$(grep -m1 -oE "<!--[[:space:]]*ciclo:.*-->" "$archivo" 2>/dev/null |
            grep -oE "$clave=[^[:space:]\"'>]+" | head -1 | cut -d= -f2-)
    printf '%s' "${valor:-$defecto}"
}

prompt_de() { ls prompts/"$1"-*.md 2>/dev/null | head -1; }

leer_estado() {
    [ -f "runs/$1.estado" ] && tr -d '[:space:]' < "runs/$1.estado" || echo "SIN-ESTADO"
}

# Estados que cierran la tarea. `PARCIAL` NO está acá a propósito: es el que
# declara una sesión que avanzó de verdad —commiteó— pero no terminó la HU, y
# habilita otra etapa sobre la misma rama en vez de dar la vuelta por perdida.
es_terminal() {
    case "$1" in OK|CERRADA|OMITIDA|BLOQUEADA) return 0 ;; *) return 1 ;; esac
}

# Estados en los que la tarea ya no avanza sin una persona: reintentarla en frío
# al reanudar solo repetiría el mismo callejón, y encima sobre una rama que ya
# tiene trabajo hecho.
necesita_humano() {
    case "$1" in BLOQUEADA|RECHAZADA|AGOTADA|INCOMPLETA) return 0 ;; *) return 1 ;; esac
}

# --- Red -------------------------------------------------------------
# ¿Responde la API? Sin `-f`: un 401 o un 404 también son "hay red".
red_ok() { curl -s -m 10 -o /dev/null "$SONDA_RED"; }

# La sesión murió sin declarar estado: ¿fue la red o fue el modelo? Solo cuenta
# como corte de red si además salió por la mala —una sesión que terminó bien y
# encima menciona ECONNREFUSED en su reporte no es un corte— o si murió sin
# alcanzar a escribir el JSON y la API sigue muda.
corte_de_red() {
    local salida="$1" rc="$2"
    [ "$rc" = 0 ] && return 1
    grep -qiE "ENOTFOUND|EAI_AGAIN|ECONNRESET|ECONNREFUSED|ETIMEDOUT|socket hang up|fetch failed|reach the API server|Connection error" "$salida" 2>/dev/null && return 0
    [ -s "$salida" ] || { red_ok || return 0; }
    return 1
}

# ¿Murió porque se agotó el límite de uso de la cuenta? Pide las dos cosas
# —que la corrida sea un error y que el motivo sea el 429— para no confundirse
# con una sesión que terminó bien y encima habla de rate limits en su reporte.
limite_de_uso() {
    local salida="$1"
    grep -q '"is_error":true' "$salida" 2>/dev/null || return 1
    grep -qE '"api_error_status":429|hit your (session|usage) limit|usage limit reached' "$salida" 2>/dev/null
}

# "You've hit your session limit · resets 5:20pm (America/La_Paz)" → cuántos
# segundos faltan para esa hora, con un minuto de margen. Vacío si no hay hora
# legible: ahí el ciclo sondea en vez de dormir a ciegas.
segundos_hasta_reset() {
    local salida="$1" hora objetivo ahora
    hora=$(grep -oE 'resets [0-9]{1,2}(:[0-9]{2})?[[:space:]]*[apAP][mM]' "$salida" 2>/dev/null |
        head -1 | sed 's/^resets //; s/[[:space:]]//g' | tr '[:lower:]' '[:upper:]')
    [ -z "$hora" ] && return 1
    case "$hora" in *:*) ;; *) hora=$(printf '%s' "$hora" | sed -E 's/^([0-9]{1,2})/\1:00/') ;; esac
    objetivo=$(date -j -f "%I:%M%p" "$hora" "+%s" 2>/dev/null) || return 1
    ahora=$(date +%s)
    [ "$objetivo" -le "$ahora" ] && objetivo=$((objetivo + 86400))
    printf '%s' $((objetivo - ahora + 60))
}

# Dormir mirando el freno de mano: un `bin/ciclo --detener` durante una espera
# larga tiene que valer, no quedar encolado horas.
dormir() {
    local total="$1" esperado=0
    while [ "$esperado" -lt "$total" ]; do
        detencion_pedida && return 1
        sleep 60
        esperado=$((esperado + 60))
    done
    return 0
}

# ¿Ya se repuso el límite? Una pregunta mínima al modelo más barato: si sigue
# agotado devuelve 429 sin consumir nada.
limite_repuesto() {
    ! claude -p 'ok' --model "$MODELO_LIVIANO" --output-format json 2>&1 |
        grep -qE '"api_error_status":429|hit your (session|usage) limit'
}

esperar_limite() {
    local salida="$1" falta esperado=0
    falta=$(segundos_hasta_reset "$salida") || falta=""
    if [ -n "$falta" ] && [ "$falta" -le "$LIMITE_MAX" ]; then
        aviso "Límite de uso agotado: el ciclo duerme $((falta / 60)) min, hasta que se reponga"
        dormir "$falta" || return 1
        return 0
    fi
    aviso "Límite de uso agotado y sin hora de reposición legible: sondeo cada $((SONDEO_LIMITE / 60)) min"
    while [ "$esperado" -lt "$LIMITE_MAX" ]; do
        dormir "$SONDEO_LIMITE" || return 1
        esperado=$((esperado + SONDEO_LIMITE))
        limite_repuesto && { log "  límite repuesto tras $((esperado / 60)) min"; return 0; }
    done
    return 1
}

esperar_red() {
    local esperado=0
    red_ok && return 0
    aviso "La API no responde: espero hasta $((ESPERA_RED / 60)) min a que vuelva la red"
    while [ "$esperado" -lt "$ESPERA_RED" ]; do
        sleep "$SONDEO_RED"
        esperado=$((esperado + SONDEO_RED))
        red_ok && { log "  red de vuelta tras ${esperado}s"; return 0; }
    done
    return 1
}

# 0 = la sesión terminó por su cuenta · 1 = la cortó el entorno y ya se
# resolvió · 2 = la cortó el entorno y sigue cortado. Lo lee quien llamó a
# sesion(); el motivo es para el mensaje.
SESION_CORTE=0
SESION_CORTE_MOTIVO=""

# --- Sesión de Claude Code -------------------------------------------
# Nunca --bare: ese modo exige ANTHROPIC_API_KEY y saltea los hooks, es decir,
# correría sin los guardarraíles de .claude/ — la única barrera que queda de pie
# cuando no hay nadie mirando.
sesion() {
    local texto="$1" salida="$2" herramientas="${3:-Read Edit Write Glob Grep Bash}" noche="${4:-0}" modelo="${5:-$MODELO_PESADO}" zonas="${6:-}" rc=0
    SESION_CORTE=0
    SESION_CORTE_MOTIVO=""
    log "  modelo: $modelo${zonas:+ · descongela: $zonas}"
    AGROCOM_TURNO_NOCHE="$noche" AGROCOM_DESCONGELA="$zonas" claude -p "$texto" \
        --model "$modelo" \
        --permission-mode dontAsk \
        --allowedTools "$herramientas" \
        --disallowedTools "$HERRAMIENTAS_PROHIBIDAS" \
        --output-format json > "$salida" 2>&1 || rc=$?
    if corte_de_red "$salida" "$rc"; then
        aviso "La sesión se cortó por la red, no por la tarea"
        SESION_CORTE=1; SESION_CORTE_MOTIVO="la red"
        esperar_red || SESION_CORTE=2
    elif limite_de_uso "$salida"; then
        aviso "La sesión se cortó por el límite de uso, no por la tarea"
        SESION_CORTE=1; SESION_CORTE_MOTIVO="el límite de uso"
        esperar_limite "$salida" || SESION_CORTE=2
    fi
    return "$rc"
}

# --- Rama de la tarea -------------------------------------------------
# La elige el ciclo, no la sesión: desde el metadato `rama=` del prompt, y si no
# está, derivada del nombre del propio archivo. Cuando la elegía la sesión, cada
# reintento inventaba una distinta y el trabajo de la vuelta anterior quedaba
# colgando en una rama que nadie volvía a mirar.
rama_de() {
    local archivo="$1" id="$2" valor
    valor=$(meta "$archivo" "rama" "")
    [ -z "$valor" ] && valor="feature/$(basename "$archivo" .md | sed "s/^${id}-//")"
    printf '%s' "$valor"
}

# Todo lo sucio que NO sea el prompt que dejó la planificación de la vuelta
# anterior. Sobre eso sí hay que abortar: es trabajo de alguien más.
sucio_ajeno() {
    git status --porcelain |
        sed -E 's/^.{3}//; s/^.* -> //' |
        grep -vE '^(prompts/[0-9]{2}-[^/]*\.md|docs/gestion/cola_tareas\.md)$' |
        head -5
}

# Los archivos de planificación (prompts encolados, cola_tareas) pueden estar
# sin commitear al volver: los deja la planificación, o el usuario retoca un
# prompt encolado mientras corre la tarea anterior. `git checkout` se niega a
# cambiar de rama si develop no tiene esa versión del archivo. Se los lleva en
# un stash y se los devuelve una vez parado en develop; solo si no vuelven a
# aplicar se aborta.
volver_a_develop() {
    local guardado=0
    if [ -n "$(git status --porcelain -- "${PLANIFICACION[@]}")" ]; then
        git stash push --quiet --include-untracked -m "ciclo: planificación sin commitear" \
            -- "${PLANIFICACION[@]}" >/dev/null 2>&1 && guardado=1
    fi
    if ! git checkout develop --quiet 2>/dev/null; then
        [ "$guardado" = 1 ] && git stash pop --quiet >/dev/null 2>&1
        return 1
    fi
    git fetch --quiet origin develop 2>/dev/null
    git merge --quiet --ff-only origin/develop 2>/dev/null ||
        aviso "develop local no pudo adelantarse a origin/develop — la rama nace de una base vieja"
    if [ "$guardado" = 1 ] && ! git stash pop --quiet >/dev/null 2>&1; then
        malo "La planificación sin commitear no volvió a aplicar sobre develop (quedó en git stash)"
        return 1
    fi
    return 0
}

# --- Avance sin commitear --------------------------------------------
# Una sesión que se cortó a mitad de camino (terminó sin estado, se agotó, la
# mataron) deja archivos sin commitear en la rama de la tarea. Si se dejan ahí,
# la tarea siguiente no puede arrancar —`preparar_rama` ve un working tree sucio
# y aborta— y la planificación tampoco puede volver a develop. El trabajo es de
# la rama en la que está: se commitea ahí, y la vuelta que la retome lo
# encuentra en git como cualquier otra etapa. Lo que escribió la planificación
# (PLANIFICACION) queda afuera: viaja en la rama de la tarea que encola, no en
# esta.
guardar_avance() {
    local id="$1" rama
    rama=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    case "$rama" in develop|master|"") return 0 ;; esac
    [ -z "$(sucio_ajeno)" ] && return 0
    git add -A >/dev/null 2>&1
    git reset -q -- "${PLANIFICACION[@]}" >/dev/null 2>&1 || true
    if git commit -q -m "guarda el avance sin cerrar de la tarea $id" \
        -m "Lo dejó sin commitear una sesión que terminó antes de cerrar la etapa. Lo commitea el ciclo para que la rama quede limpia: la etapa siguiente lo retoma desde acá y la tarea que sigue puede arrancar."; then
        ok "avance sin commitear de la tarea $id guardado en $rama"
    fi
    return 0
}

# --- Base limpia ------------------------------------------------------
# Deja al ciclo parado en la rama de la tarea, nacida de un develop al día, con
# el prompt de esta misma tarea ya commiteado adentro.
preparar_rama() {
    local id="$1" rama="$2" ajeno
    ajeno=$(sucio_ajeno)
    if [ -n "$ajeno" ]; then
        malo "Working tree sucio fuera de la planificación — no arranco una tarea encima"
        printf '%s\n' "$ajeno" | eco
        return 1
    fi

    volver_a_develop || { malo "No pude pararme en un develop al día"; return 1; }

    if git rev-parse --verify --quiet "refs/heads/$rama" >/dev/null; then
        git checkout "$rama" --quiet || { malo "No pude retomar $rama"; return 1; }
        log "  retomo la rama $rama ($(git rev-list --count develop.."$rama") commit(s) ya hechos)"
    else
        git checkout -b "$rama" --quiet || { malo "No pude crear $rama"; return 1; }
        log "  rama $rama creada desde develop"
    fi

    # El prompt de esta tarea lo escribió la planificación de la vuelta anterior
    # y quedó sin commitear a propósito: entra como primer commit de la rama de
    # la HU que encola.
    if [ -n "$(git status --porcelain -- "${PLANIFICACION[@]}")" ]; then
        git add -- "${PLANIFICACION[@]}"
        git commit -q -m "encola la tarea $id y su prompt" \
            -m "Lo escribió la sesión de planificación al cerrar la tarea anterior. Viaja en la rama de la tarea que encola, no en un PR propio: la unidad de entrega es la HU completa." || return 1
        ok "prompt de la tarea $id commiteado en $rama"
    fi
    return 0
}

# --- Fase 1: implementar ---------------------------------------------
# Códigos: 0 la HU quedó completa · 1 se rindió · 2 BLOQUEADA (decisión humana)
#          3 avanzó pero se le acabaron las etapas sin cerrarla
#          4 no pudo ni arrancar (working tree sucio ajeno, develop inalcanzable)
#
# Una HU del plan de sprints no entra en una sesión, y partirla en tareas para
# que entre es lo que llenaba el historial de PRs de un commit en `agrocom-api`
# antes de este mecanismo. Así que la fase encadena sesiones sobre la MISMA
# rama: cada una lee lo que dejó la anterior, suma sus commits, y declara
# `PARCIAL` mientras la historia siga abierta. El PR se abre recién al `OK`.
fase_implementar() {
    local id="$1" archivo rama estado texto sesiones fallos cortes hechos
    archivo=$(prompt_de "$id") || true
    [ -z "$archivo" ] && { malo "No existe prompt para la tarea $id"; return 1; }

    local noche modelo zonas etapas
    noche=$(meta "$archivo" "turno-noche" "1")
    modelo=$(meta "$archivo" "modelo" "$MODELO_PESADO")
    zonas=$(meta "$archivo" "descongela" "")
    etapas=$(meta "$archivo" "etapas" "$ETAPAS_IMPL")
    rama=$(rama_de "$archivo" "$id")

    preparar_rama "$id" "$rama" || return 4

    sesiones=0
    fallos=0
    cortes=0
    while [ "$sesiones" -lt "$etapas" ]; do
        sesiones=$((sesiones + 1))
        marcar "$id implementar · etapa $sesiones/$etapas en $rama"
        rm -f "runs/$id.estado"

        texto="$(cat "$archivo")

$(pie_verify "$id")"
        if [ "$sesiones" -gt 1 ]; then
            texto="$texto

---
## Etapa $sesiones de $etapas — continuación, no arranque

Ya estás parado en la rama \`$rama\`, con el trabajo de las etapas anteriores
commiteado. **No empieces de cero ni rehagas lo hecho**: leé lo que hay y seguí.

### Commits que ya tiene la rama
$(git log --oneline develop.."$rama" 2>/dev/null || echo '(ninguno)')

### runs/$id.md — lo que reportó la etapa anterior
$(tail -40 "runs/$id.md" 2>/dev/null || echo '(no escribió reporte)')

### Últimas líneas de su corrida
$(tail -30 "runs/$id.log" 2>/dev/null || echo '(sin log)')

Seguí desde ahí hasta cerrar la historia entera. Al terminar esta etapa escribí
en \`runs/$id.estado\` una sola palabra:

- \`PARCIAL\` — avanzaste y commiteaste, pero la HU todavía no está completa.
  Habrá otra etapa que retome desde acá. Dejá en \`runs/$id.md\` qué falta,
  concreto, para que la etapa siguiente no tenga que adivinarlo.
- \`OK\` — la HU está entera: todos sus criterios de aceptación cubiertos y
  \`./bin/verify\` en 0. Recién con esto se abre el PR.
- \`BLOQUEADA\` — falta una decisión que no te corresponde. Escribí la pregunta
  concreta. Es una respuesta válida y termina la tarea.

No toques los tests para que pasen."
        fi

        sesion "$texto" "runs/$id.log" "$HERRAMIENTAS_IMPL" "$noche" "$modelo" "$zonas"
        estado=$(leer_estado "$id")
        hechos=$(git rev-list --count develop.."$rama" 2>/dev/null || echo 0)
        log "sesión terminada · estado declarado: $estado · $hechos commit(s) en $rama"

        case "$estado" in
            BLOQUEADA)
                malo "Tarea $id BLOQUEADA — necesita una decisión del usuario"
                return 2 ;;
            OK|CERRADA|OMITIDA)
                ok "Tarea $id completa ($estado) en $sesiones etapa(s), $hechos commit(s)"
                return 0 ;;
            PARCIAL)
                fallos=0
                ok "Etapa $sesiones cerrada · $hechos commit(s) · la HU sigue abierta"
                abortar_si_detenido && return 2
                ;;
            *)
                if [ "$SESION_CORTE" != 0 ]; then
                    if [ "$SESION_CORTE" = 2 ]; then
                        detencion_pedida && return 2
                        alerta "$SESION_CORTE_MOTIVO no se repuso a tiempo: la tarea $id no avanza por el entorno, no por ella"
                        return 4
                    fi
                    cortes=$((cortes + 1))
                    if [ "$cortes" -ge "$CORTES_MAX" ]; then
                        alerta "$SESION_CORTE_MOTIVO cortó $cortes sesiones de la tarea $id: así no avanza"
                        return 4
                    fi
                    aviso "Etapa $sesiones cortada por $SESION_CORTE_MOTIVO ($cortes/$CORTES_MAX) — no cuenta como fallo, la repito"
                    sesiones=$((sesiones - 1))
                    abortar_si_detenido && return 2
                    continue
                fi
                fallos=$((fallos + 1))
                malo "Sin estado declarado (quedó en '$estado') — fallo $fallos/$FALLOS_IMPL"
                if [ "$fallos" -ge "$FALLOS_IMPL" ]; then
                    echo "AGOTADA" > "runs/$id.estado"
                    malo "Tarea $id: $FALLOS_IMPL sesiones seguidas sin declarar estado"
                    return 1
                fi
                ;;
        esac
    done

    # Se acabaron las etapas con la historia todavía abierta. El trabajo hecho es
    # válido y está commiteado: se entrega en un PR en borrador para que lo mire
    # una persona, en vez de tirarlo o de mergear media HU.
    echo "INCOMPLETA" > "runs/$id.estado"
    aviso "Tarea $id: se agotaron las $etapas etapas con la HU sin cerrar ($hechos commit(s) hechos)"
    return 3
}

# --- Fase 2: verificar ------------------------------------------------
# Sesión separada, y a propósito: quien implementó ya se convenció de que está
# bien. La verificación corre siempre con los tests congelados —no edita código,
# solo escribe su veredicto en runs/, que no está congelado— así que no puede
# "arreglar" el criterio que la evalúa.
#
# La sesión de CORRECCIÓN, en cambio, hereda el turno-noche del prompt de la
# tarea. Congelarla siempre parecía la opción segura y no lo era: una tarea cuyo
# entregable ES un test —una aduana, un gate— quedaba sin poder corregir su
# propio archivo, y la vuelta se agotaba sola. La garantía que importa no se
# pierde: quien juzga sigue siendo el verificador, que no puede tocar nada.
#
# El verificador tiene que dejar dos archivos: runs/NN.veredicto (una palabra)
# y runs/NN-veredicto.md (el detalle). Si falta la palabra, se busca en el
# encabezado del detalle: APROBADO o RECHAZADO en sus primeras líneas. Si
# tampoco está ahí, sigue siendo SIN-VEREDICTO — no se cuenta como rechazo sin
# leer lo que el verificador sí haya dicho.
leer_veredicto() {
    local id="$1" palabra
    if [ -f "runs/$id.veredicto" ]; then
        tr -d '[:space:]' < "runs/$id.veredicto"
        return 0
    fi
    palabra=$(head -20 "runs/$id-veredicto.md" 2>/dev/null | grep -owE 'APROBADO|RECHAZADO' | head -1)
    printf '%s' "${palabra:-SIN-VEREDICTO}"
}

fase_verificar() {
    local id="$1" intento veredicto texto archivo noche zonas
    local plantilla=prompts/plantillas/verificar.md
    [ -f "$plantilla" ] || { malo "Falta $plantilla"; return 1; }

    archivo=$(prompt_de "$id")
    noche=$(meta "$archivo" "turno-noche" "1")
    zonas=$(meta "$archivo" "descongela" "")

    # Solo las tareas de la lista crítica de CLAUDE.md pagan la sesión de
    # verificación. Para una pantalla o un CRUD, la compuerta es ./bin/verify +
    # el CI del PR, que es lo mismo que juzgaba el verificador y no cuesta una
    # sesión de modelo.
    if [ "$(meta "$archivo" "critica" "no")" != "si" ]; then
        log "$id sin verificación independiente (no crítica): la compuerta es ./bin/verify y el CI"
        return 0
    fi

    for intento in $(seq 0 "$INTENTOS_ARREGLO"); do
        marcar "$id verificar (vuelta $intento)"
        rm -f "runs/$id.veredicto"
        texto=$(sed "s/{{ID}}/$id/g" "$plantilla")
        sesion "$texto" "runs/$id-verificar.log" "Read Glob Grep Bash Write" 1 "$MODELO_PESADO" ""

        veredicto=$(leer_veredicto "$id")
        log "veredicto: $veredicto"
        [ "$veredicto" = "APROBADO" ] && { ok "Tarea $id aprobada por el verificador"; return 0; }

        [ "$intento" -eq "$INTENTOS_ARREGLO" ] && break
        abortar_si_detenido && return 2

        # Corrección: sesión nueva que recibe los hallazgos, no la sesión que
        # los produjo. Los tests siguen congelados.
        marcar "$id corregir hallazgos (vuelta $((intento + 1)))"
        sesion "Sos una sesión de corrección sobre la rama actual del repo agrocom-field.

Un verificador independiente RECHAZÓ el trabajo de la tarea $id. Sus hallazgos:

$(cat "runs/$id-veredicto.md" 2>/dev/null || echo '(no escribió detalle)')

Corregí cada hallazgo en la rama actual, sin cambiar el alcance de la tarea y
sin tocar los tests para que pasen: si un test está mal, eso es un hallazgo
para el usuario, no algo que arregles vos.

Commiteá en grupos por función — un commit por pieza coherente, con mensaje en
español, imperativo, explicando el porqué. Corré ./bin/verify y no cierres
hasta que devuelva 0.

Escribí runs/$id.md agregando qué corregiste.

$(pie_verify "$id")" \
            "runs/$id-corregir-$intento.log" "$HERRAMIENTAS_IMPL" "$noche" "$MODELO_PESADO" "$zonas"
    done

    malo "Tarea $id sigue RECHAZADA tras $INTENTOS_ARREGLO correcciones"
    echo "RECHAZADA" > "runs/$id.estado"
    return 1
}

# --- La rama sale al PR al día con develop -----------------------------
# Una rama atrasada no solo arriesga un conflicto: si el PR se abre igual,
# mergearla revierte lo que entró mientras tanto.
#
# El rebase que sale limpio se hace acá y listo. El que choca necesita criterio
# —casi siempre es un PR anterior de la misma rama mergeado con squash— y eso
# no se resuelve a ciegas en bash: se avisa, el PR se abre igual, y fase_ci lo
# detecta por el merge ref en menos de tres minutos y le pone una sesión.
poner_al_dia_con_develop() {
    local id="$1" rama="$2"
    git fetch -q origin develop 2>/dev/null || true
    git merge-base --is-ancestor origin/develop HEAD 2>/dev/null && return 0

    log "  la rama está atrasada respecto de develop: rebase antes de abrir el PR"
    git branch -f "respaldo/$(printf '%s' "$rama" | tr / -)-$(date +%H%M)" HEAD 2>/dev/null || true
    if git rebase origin/develop >/dev/null 2>&1; then
        forzar_push="si"
        ok "rama al día con develop ($(git rev-list --count origin/develop..HEAD) commit(s) propios)"
    else
        git rebase --abort >/dev/null 2>&1 || true
        alerta "Tarea $id · la rama $rama no rebasa limpio sobre develop: el PR nace en conflicto y lo va a rehacer una sesión"
    fi
    return 0
}

# --- Fase 3: abrir el PR ----------------------------------------------
# El título y el cuerpo los escribe la sesión (sabe qué hizo); el ciclo decide
# si va en borrador, porque eso depende de si la tarea es crítica y esa es una
# regla del proceso, no del contenido.
fase_pr() {
    local id="$1" forzar_borrador="${2:-no}" archivo critica rama numero
    archivo=$(prompt_de "$id")
    critica=$(meta "$archivo" "critica" "no")
    rama=$(git rev-parse --abbrev-ref HEAD)

    if [ "$rama" = "develop" ] || [ "$rama" = "master" ]; then
        malo "La tarea $id no dejó una rama feature/* con el trabajo"
        return 1
    fi

    marcar "$id abrir PR desde $rama"
    guardar_avance "$id"

    local forzar_push="no"
    poner_al_dia_con_develop "$id" "$rama"
    if [ "$forzar_push" = "si" ]; then
        git push --quiet --force-with-lease -u origin "$rama" 2>&1 | tail -2 | eco
    else
        git push --quiet -u origin "$rama" 2>&1 | tail -2 | eco
    fi

    numero=$(gh pr list --head "$rama" --json number -q '.[0].number' 2>/dev/null)
    if [ -n "$numero" ]; then
        log "PR #$numero ya existía para $rama"
    else
        local titulo cuerpo
        if [ -f "runs/$id.pr.md" ]; then
            # La sesión escribe el .pr.md en markdown, así que la primera
            # línea viene como encabezado. Sin sacarle el '#' el PR nace
            # titulado "# Tarea NN — PR".
            titulo=$(head -1 "runs/$id.pr.md" | sed 's/^#\{1,6\}[[:space:]]*//')
            [ -z "$titulo" ] && titulo="Tarea $id"
            cuerpo=$(tail -n +2 "runs/$id.pr.md")
        else
            titulo="Tarea $id"
            cuerpo=$(cat "runs/$id.md" 2>/dev/null || echo "Ver runs/$id.md")
        fi

        # El borrador queda SOLO para la HU que se quedó sin etapas antes de
        # cerrarse: media historia no se mergea sola, y el ciclo retoma esa rama
        # en la vuelta siguiente, así que no traba la cola.
        #
        # Una tarea crítica ya NO va en borrador — en `agrocom-api` un PR crítico
        # en borrador bloqueó doce HU seguidas hasta que el ciclo se quedó sin
        # trabajo (el planificador no tenía de dónde partir mientras esa rama
        # siguiera sin mergear). La revisión línea por línea de CLAUDE.md sigue
        # siendo obligatoria, pero se hace SOBRE develop y queda anotada en
        # runs/revision-pendiente.txt; no frena la integración.
        local borrador=""
        [ "$forzar_borrador" = "si" ] && borrador="--draft"

        printf '%s' "$cuerpo" > runs/.cuerpo-pr.md
        # Sin comillas alrededor de $borrador, a propósito: cuando está vacío
        # tiene que desaparecer de la línea de comando.
        # shellcheck disable=SC2086
        gh pr create --base develop --head "$rama" \
            --title "$titulo" --body-file runs/.cuerpo-pr.md $borrador 2>&1 | tail -3 | eco
        rm -f runs/.cuerpo-pr.md
        numero=$(gh pr list --head "$rama" --json number -q '.[0].number' 2>/dev/null)
    fi

    [ -z "$numero" ] && { malo "No se pudo abrir ni encontrar el PR de $rama"; return 1; }
    echo "$numero" > "runs/$id.pr"
    local motivo=""
    if [ "$critica" = "si" ]; then
        # No frena el merge, pero no se pierde: queda en la lista que el usuario
        # revisa sobre develop (CLAUDE.md, "qué no delegar sin revisión").
        echo "$id  PR #$numero  $rama" >> runs/revision-pendiente.txt
        motivo=' (crítica: se integra igual, anotada en runs/revision-pendiente.txt para revisión línea por línea)'
    fi
    [ "$forzar_borrador" = "si" ] && motivo=' (borrador: la HU quedó sin cerrar, espera revisión humana)'
    ok "PR #$numero$motivo"
    return 0
}

# --- Fase 4: esperar a CI ---------------------------------------------
# Devuelve: 0 integrado · 1 CI en rojo · 2 PR cerrado sin merge
#           3 borrador verde (crítica, esperando a una persona) · 4 se agotó la espera
#           5 PR en conflicto: no hay merge ref, CI no va a arrancar nunca
#           6 sin un solo check tras SIN_CHECKS_MAX: CI no arrancó
esperar_ci() {
    local numero="$1" id="${2:-?}" limite=$((SECONDS + ESPERA_CI)) arranque=$SECONDS
    local estado borrador fallidos pendientes total fusion previo salto ultimo=0 sin_checks=0
    while :; do
        estado=$(gh pr view "$numero" --json state -q .state 2>/dev/null || echo "")
        case "$estado" in
            MERGED) return 0 ;;
            CLOSED) return 2 ;;
        esac

        fallidos=$(gh pr checks "$numero" --json state -q '[.[] | select(.state == "FAILURE" or .state == "TIMED_OUT" or .state == "CANCELLED")] | length' 2>/dev/null || echo 0)
        [ "${fallidos:-0}" -gt 0 ] && return 1

        # "Ningún check" y "todos los checks pendientes" son estados distintos.
        # Un PR en conflicto no dispara workflow, así que ese caso se reconoce
        # por el merge ref, no por los checks. Un `gh` que falla no es
        # información: es un hipo de red o de la API, así que hacen falta tres
        # sondeos buenos y seguidos sin un solo check para creerlo.
        if total=$(gh pr checks "$numero" --json state -q 'length' 2>/dev/null); then
            if [ "${total:-0}" -eq 0 ]; then
                sin_checks=$((sin_checks + 1))
                fusion=$(gh pr view "$numero" --json mergeStateStatus -q .mergeStateStatus 2>/dev/null || echo "")
                [ "$fusion" = "DIRTY" ] && return 5
                [ "$sin_checks" -ge 3 ] && [ $((SECONDS - arranque)) -ge "$SIN_CHECKS_MAX" ] && return 6
            else
                sin_checks=0
            fi
        else
            total=""
        fi

        pendientes=$(gh pr checks "$numero" --json state -q '[.[] | select(.state == "PENDING" or .state == "QUEUED" or .state == "IN_PROGRESS")] | length' 2>/dev/null || echo 1)
        borrador=$(gh pr view "$numero" --json isDraft -q .isDraft 2>/dev/null || echo false)
        if [ "${pendientes:-1}" -eq 0 ] && [ "$borrador" = "true" ]; then
            return 3
        fi

        # La espera deja rastro: el estado se reescribe en cada sondeo y la
        # bitácora recibe una línea cada dos minutos.
        printf '%s\n' "$id esperando CI del PR #$numero · $((SECONDS - arranque))s de ${ESPERA_CI}s · ${total:-?} check(s), ${pendientes} pendiente(s)" > runs/ciclo.estado
        if [ $((SECONDS - ultimo)) -ge 120 ]; then
            log "  PR #$numero · $((SECONDS - arranque))s de ${ESPERA_CI}s · ${total:-?} check(s), ${pendientes} pendiente(s)"
            ultimo=$SECONDS
        fi

        # El límite se evalúa DESPUÉS de consultar, nunca antes: si se evalúa
        # primero, un PR que se integró mientras se dormía el último sondeo se
        # reporta como "se agotó la espera" sin haberlo mirado una última vez.
        [ "$SECONDS" -ge "$limite" ] && return 4

        previo=$SECONDS
        sleep "$SONDEO_CI"

        # La máquina puede suspenderse mientras el ciclo corre de noche. El
        # tiempo dormido no es tiempo de espera: si el reloj saltó mucho más de
        # lo que duraba el sondeo, se le devuelve al presupuesto.
        salto=$((SECONDS - previo - SONDEO_CI))
        if [ "$salto" -gt "$((SONDEO_CI * 2))" ]; then
            limite=$((limite + salto))
            log "  la máquina estuvo suspendida $((salto / 60)) min — no cuentan como espera"
        fi
    done
}

fase_ci() {
    local id="$1" numero intento archivo noche zonas
    archivo=$(prompt_de "$id")
    noche=$(meta "$archivo" "turno-noche" "1")
    zonas=$(meta "$archivo" "descongela" "")
    numero=$(cat "runs/$id.pr" 2>/dev/null || echo "")
    [ -z "$numero" ] && { malo "Tarea $id sin PR registrado"; return 1; }

    for intento in $(seq 0 "$INTENTOS_ARREGLO"); do
        marcar "$id esperando CI del PR #$numero"
        esperar_ci "$numero" "$id"
        case $? in
            0) ok "PR #$numero integrado en develop"; return 0 ;;
            2) malo "PR #$numero cerrado sin mergear — alguien lo cerró a mano"; return 1 ;;
            3) aviso "PR #$numero en verde y en borrador: la HU quedó sin cerrar, la revisa una persona"; return 0 ;;
            4) malo "Se agotaron los $((ESPERA_CI / 60)) min de espera de CI"; return 1 ;;
            6) alerta "Tarea $id · PR #$numero sin un solo check tras $((SIN_CHECKS_MAX / 60)) min: CI no arrancó. Miralo a mano."
               return 1 ;;
            5) alerta "Tarea $id · PR #$numero en conflicto con develop: sin merge ref no hay workflow, CI no va a arrancar nunca"
               [ "$intento" -eq "$INTENTOS_ARREGLO" ] && break
               abortar_si_detenido && return 2
               marcar "$id rehacer la rama sobre develop (vuelta $((intento + 1)))"
               sesion "El PR #$numero del repo agrocom-field está en conflicto con develop. GitHub no
puede calcular el merge ref, así que CI no arrancó y no va a arrancar solo.
Estás parado en su rama.

Commits de la rama que develop no tiene:

$(git log --oneline origin/develop..HEAD 2>/dev/null)

Delta de contenido contra develop:

$(git diff --stat origin/develop HEAD 2>/dev/null)

La causa habitual es que un PR anterior de esta misma rama se mergeó con
squash: los commits originales quedaron sin correspondencia con develop y
cualquier rebase choca.

Rehacé la rama sobre origin/develop dejando SOLO los commits cuyo contenido
develop todavía no tiene:

  git branch respaldo/\$(git rev-parse --abbrev-ref HEAD | tr / -)-\$(date +%H%M)
  git switch --detach origin/develop
  git cherry-pick <cada commit que falte, en orden>
  git branch -f <la rama> HEAD && git switch <la rama>
  git push --force-with-lease origin <la rama>

Antes de pushear confirmá con 'git diff --stat origin/develop HEAD' que el
delta es exactamente lo que agrega esta tarea. Si aparecen archivos que la
tarea no tocó, la rama está por revertir el trabajo de otro PR — eso no se
pushea, se saca del rebase primero.

No borres la rama de respaldo y no uses 'git reset --hard': hay un hook que lo
bloquea.

$(pie_verify "$id")" \
                   "runs/$id-conflicto-$intento.log" "$HERRAMIENTAS_IMPL" "$noche" "$MODELO_LIVIANO" "$zonas"
               continue ;;
        esac

        malo "CI en rojo en el PR #$numero"
        [ "$intento" -eq "$INTENTOS_ARREGLO" ] && break
        abortar_si_detenido && return 2

        marcar "$id corregir CI (vuelta $((intento + 1)))"
        sesion "El PR #$numero del repo agrocom-field quedó con CI en rojo. Estás parado en su rama.

Salida de los checks:

$(gh pr checks "$numero" 2>&1 | head -30)

$(gh run view "$(gh run list --branch "$(git rev-parse --abbrev-ref HEAD)" --limit 1 --json databaseId -q '.[0].databaseId' 2>/dev/null)" --log-failed 2>/dev/null | tail -60)

Reproducí la falla en local con ./bin/verify, corregí la causa y commiteá el
arreglo (mensaje en español, imperativo, explicando qué rompía). Después
pusheá a la misma rama: el auto-merge reintenta solo cuando CI queda verde.

No toques los tests para que pasen. Si el test tiene razón y el código está
mal, el que se corrige es el código.

$(pie_verify "$id")" \
            "runs/$id-ci-$intento.log" "$HERRAMIENTAS_IMPL" "$noche" "$MODELO_LIVIANO" "$zonas"
    done

    malo "Tarea $id: CI sigue en rojo tras $INTENTOS_ARREGLO intentos"
    return 1
}

# --- Fase 5: planificar la siguiente ----------------------------------
fase_planificar() {
    local id="$1" texto
    local plantilla=prompts/plantillas/planificar.md
    [ -f "$plantilla" ] || { malo "Falta $plantilla"; return 1; }

    # Cola en lote: si la planificación anterior ya dejó tareas escritas por
    # delante, no se gasta otra sesión en pensar la siguiente — se consume lo
    # que hay.
    local pendiente; pendiente=$(siguiente_id 2>/dev/null || true)
    if [ -n "$pendiente" ] && [ "$pendiente" != "$id" ]; then
        ok "Planificación salteada: la cola ya tiene la tarea $pendiente escrita"
        return 0
    fi

    marcar "$id planificar la tarea siguiente"
    # De vuelta a develop con lo recién integrado: el prompt que se escriba acá
    # tiene que decidirse mirando el estado real del repo, no el de la rama que
    # acaba de mergearse.
    guardar_avance "$id"
    volver_a_develop || { malo "No pude pararme en un develop al día"; return 1; }

    texto=$(sed "s/{{ID}}/$id/g" "$plantilla")
    sesion "$texto" "runs/$id-planificar.log" "Read Glob Grep Bash Write" 1 "$MODELO_PESADO" ""

    local ultima; ultima=$(tail -1 "$COLA" 2>/dev/null || echo "")
    log "cola: $(tr '\n' ' ' < "$COLA" 2>/dev/null)"

    if detencion_pedida; then
        aviso "La planificación pidió detener el ciclo: $(head -1 "$DETENER")"
        return 1
    fi
    [ -z "$ultima" ] && { malo "La planificación no dejó ninguna tarea en la cola"; return 1; }
    [ -z "$(prompt_de "$ultima")" ] && { malo "La cola pide '$ultima' pero no existe prompts/$ultima-*.md"; return 1; }

    # Los archivos quedan escritos y SIN commitear a propósito: los commitea
    # `preparar_rama` como primer commit de la rama de esa misma tarea, en la
    # vuelta siguiente.
    ok "Próxima tarea: $ultima ($(basename "$(prompt_de "$ultima")"))"
    log "queda sin commitear (viaja en la rama de la $ultima): $(git status --porcelain -- "${PLANIFICACION[@]}" | sed -E 's/^.{3}//' | tr '\n' ' ')"
    return 0
}

# --- Una vuelta completa ----------------------------------------------
# Códigos: 0 integrada · 1 no llegó a integrarse · 2 parada pedida
#          3 no pudo arrancar: es el entorno, no la tarea — el bucle se corta.
#          4 BLOQUEADA: espera una decisión humana — no cuenta como fallo.
#
# Que una tarea trabada NO corte el bucle es deliberado. El usuario mira el
# proyecto en paralelo y prefiere que el ciclo siga avanzando por el backlog
# antes que quedarse esperándolo despierto. Lo trabado queda marcado en
# `runs/NN.estado` —`siguiente_id` no lo vuelve a tomar— y, si tenía trabajo
# hecho, en un PR en borrador que el auto-merge no toca. Lo único que corta el
# bucle es una parada pedida, o TAREAS_TRABADAS seguidas sin integrar — y una
# tarea BLOQUEADA no es ninguna de las dos: se saltea sin tocar el contador.
vuelta() {
    local id="$1" r salida=0
    fase "Tarea $id — $(basename "$(prompt_de "$id")" 2>/dev/null || echo 'sin prompt')"

    fase_implementar "$id"; r=$?
    guardar_avance "$id"
    case "$r" in
        0)
            abortar_si_detenido && return 2
            if fase_verificar "$id"; then
                abortar_si_detenido && return 2
                if fase_pr "$id"; then
                    fase_ci "$id" || salida=1
                else
                    salida=1
                fi
            else
                # Rechazada tras las vueltas de corrección. El trabajo existe y
                # está commiteado: se publica en borrador —con los hallazgos del
                # verificador en runs/— en vez de quedar solo en una rama local
                # que nadie va a mirar. El auto-merge saltea los borradores.
                salida=1
                abortar_si_detenido || fase_pr "$id" "si" ||
                    malo "Tarea $id rechazada y sin PR: el trabajo quedó solo en la rama local"
            fi
            ;;
        2)
            # BLOQUEADA, o parada pedida en medio de las etapas. Sale con 4, no
            # con 1: una tarea que espera una decisión tuya no es un fallo del
            # ciclo. El bloqueo se avisa y se saltea; lo que sigue en la cola no
            # tiene por qué depender de lo mismo.
            detencion_pedida || { malo "Tarea $id necesita una decisión del usuario — mirá runs/$id.md"; salida=4; }
            [ "$salida" -eq 4 ] || salida=1
            ;;
        3)
            # Se acabaron las etapas con la HU sin cerrar: se entrega lo hecho.
            salida=1
            if fase_pr "$id" "si"; then
                aviso "Tarea $id entregada incompleta en el PR #$(cat "runs/$id.pr" 2>/dev/null) — decidís vos si se sigue o se cierra"
            fi
            ;;
        4)
            # No se pudo ni arrancar. Eso no dice nada de la tarea —es el
            # entorno— y planificar fallaría por lo mismo. Se corta el bucle
            # con el motivo claro, sin inflar el contador de tareas trabadas.
            return 3 ;;
        *)
            salida=1
            ;;
    esac

    detencion_pedida && return 2

    # La planificación corre SIEMPRE, incluso si la tarea se trabó: sin ella la
    # cola se queda sin fila siguiente y el bucle se detendría por falta de
    # trabajo, que es justo lo que no se quiere. Que la planificación falle o
    # pida detener NO convierte en fallida a una tarea que sí se integró: son
    # dos cosas distintas, y confundirlas infla el contador de "seguidas sin
    # integrar" que corta el bucle.
    if ! fase_planificar "$id"; then
        detencion_pedida && return 2
        [ "$salida" -eq 0 ] && return 0
        return "$salida"
    fi
    return "$salida"
}

# --- Cola --------------------------------------------------------------
# La cola es un archivo de ids, uno por línea. Se toma el primero que todavía
# no tenga estado terminal — así retomar después de un corte es leer un archivo,
# no reconstruir de memoria dónde se había quedado.
siguiente_id() {
    [ -f "$COLA" ] || return 1
    local id
    while read -r id; do
        [ -z "$id" ] && continue
        case "$id" in \#*) continue ;; esac
        local estado; estado=$(leer_estado "$id")
        es_terminal "$estado" && continue
        necesita_humano "$estado" && continue
        printf '%s' "$id"
        return 0
    done < "$COLA"
    return 1
}

# --- Reconciliación con git --------------------------------------------
# `runs/NN.estado` guarda lo que DECLARÓ la sesión, no lo que terminó pasando
# con la tarea. Las dos cosas se separan seguido: una tarea queda AGOTADA
# porque su sesión se cortó sin escribir el estado, y después se integra igual
# — por un reintento, o a mano. El archivo queda mintiendo, `--estado` la sigue
# listando como trabada y `necesita_humano` la saltearía si volviera a una
# cola.
#
# La fuente de verdad es el PR mergeado. Se lo busca por dos caminos y se
# corrige solo cuando alguno da:
#
#   1. un PR mergeado cuya rama es la `rama=` del prompt de la tarea;
#   2. un commit en develop cuyo ASUNTO nombra la tarea — el squash-merge deja
#      ahí el título del PR con su `(#NN)`.
#
# El asunto y no el mensaje entero: el cuerpo de un prompt puede mencionar que
# continúa a otra tarea, y buscar en todo el texto le adjudicaría a esa otra
# el PR equivocado.
#
# Sin evidencia no toca nada: una tarea trabada de verdad tiene que seguir
# viéndose trabada. `BLOQUEADA` tampoco se toca — no es un desfase, es una
# pregunta esperando respuesta, y contestarla no es trabajo de un script.
BASE_RECONCILIA=develop

es_desfasable() {
    case "$1" in AGOTADA|INCOMPLETA|RECHAZADA|SIN-ESTADO) return 0 ;; *) return 1 ;; esac
}

# Imprime "<pr>|<de dónde salió>" si encuentra que la tarea sí se integró.
evidencia_integracion() {
    local id="$1" archivo rama pr linea
    archivo=$(prompt_de "$id")
    if [ -n "$archivo" ]; then
        rama=$(meta "$archivo" "rama" "")
        if [ -n "$rama" ]; then
            pr=$(gh pr list --state merged --head "$rama" --json number --jq '.[0].number // empty' 2>/dev/null)
            if [ -n "$pr" ]; then
                printf '%s|rama %s' "$pr" "$rama"
                return 0
            fi
        fi
    fi
    linea=$(git log "$BASE_RECONCILIA" --format='%h %s' -400 2>/dev/null | grep -iE "tarea $id([^0-9]|$)" | head -1)
    if [ -n "$linea" ]; then
        pr=$(printf '%s' "$linea" | sed -nE 's/.*\(#([0-9]+)\).*/\1/p')
        if [ -n "$pr" ]; then
            printf '%s|commit %s' "$pr" "${linea%% *}"
            return 0
        fi
    fi
    return 1
}

reconciliar() {
    local simular=0
    [ "${1:-}" = "--simular" ] && simular=1

    git fetch --quiet origin develop 2>/dev/null && BASE_RECONCILIA=origin/develop

    # El id que el ciclo está corriendo AHORA queda afuera: su estado está en
    # blanco porque la sesión todavía no lo escribió, no porque nadie lo haya
    # actualizado. Esto se puede correr con el ciclo vivo, y esa es la idea.
    local encurso; encurso=$(sed -nE 's/^([0-9]+) .*/\1/p' runs/ciclo.estado 2>/dev/null | head -1)

    local ids id estado ev pr por corregidas=0 sin_evidencia="" tocadas=""
    ids=$( { ls runs/[0-9][0-9].estado 2>/dev/null | sed -E 's|runs/([0-9]+)\.estado|\1|'
             grep -vE '^[[:space:]]*(#|$)' "$COLA" 2>/dev/null | tr -d '[:space:]'
           } | sort -un )

    fase "Reconciliación de runs/*.estado con git$([ "$simular" = 1 ] && printf ' (simulada)')"
    log "base: $BASE_RECONCILIA${encurso:+ · en curso, sin tocar: $encurso}"

    for id in $ids; do
        [ -n "$id" ] || continue
        [ "$id" = "$encurso" ] && continue
        estado=$(leer_estado "$id")
        es_desfasable "$estado" || continue

        if ev=$(evidencia_integracion "$id"); then
            pr="${ev%%|*}"; por="${ev#*|}"
            if [ "$simular" = 1 ]; then
                ok "$id: $estado → CERRADA (PR #$pr, por $por) — simulado, no escribí nada"
            else
                printf 'CERRADA\n' > "runs/$id.estado"
                printf '%s\n' "$pr" > "runs/$id.pr"
                ok "$id: $estado → CERRADA (PR #$pr, por $por)"
            fi
            tocadas="$tocadas| $id | $estado | CERRADA | PR #$pr, por $por |
"
            corregidas=$((corregidas + 1))
        else
            [ "$estado" = "SIN-ESTADO" ] && continue   # todavía no corrió: no es un desfase
            sin_evidencia="$sin_evidencia $id:$estado"
        fi
    done

    [ -n "$sin_evidencia" ] && aviso "Sigue(n) trabada(s) de verdad, sin PR que las respalde:$sin_evidencia"
    [ "$corregidas" -eq 0 ] && { ok "Nada que corregir: los estados coinciden con git"; return 0; }

    if [ "$simular" = 1 ]; then
        log "$corregidas tarea(s) se corregirían. Sin --simular se aplican."
        return 0
    fi

    # El rastro importa tanto como la corrección: sin esto, mañana parece que
    # alguien editó estados a mano y no queda contra qué chequearlo.
    local informe="runs/reconciliacion-$(date +%F).md"
    {
        printf '\n## Corrida %s\n\n' "$(date '+%d/%m/%Y %H:%M')"
        printf 'Base: `%s`\n\n' "$BASE_RECONCILIA"
        printf '| Id | Decía | Ahora | Evidencia |\n|---|---|---|---|\n'
        printf '%s' "$tocadas"
        [ -n "$sin_evidencia" ] && printf '\nSin evidencia, quedaron como estaban:%s\n' "$sin_evidencia"
    } >> "$informe"
    ok "$corregidas tarea(s) corregida(s) · rastro en $informe"
}

# --- Modos de invocación -----------------------------------------------
case "${1:-}" in
    --detener)
        shift
        printf '%s\n' "${*:-parada pedida a mano el $(date '+%d/%m %H:%M')}" > "$DETENER"
        printf 'Parada pedida. El ciclo termina la fase en curso y no toma otra tarea.\n'
        [ -f "$PID" ] && printf 'Corriendo con PID %s — para cortarlo ya: kill %s\n' "$(cat "$PID")" "$(cat "$PID")"
        exit 0 ;;
    --reanudar)
        rm -f "$DETENER"; printf 'Bandera de parada levantada. Podés arrancar con bin/ciclo.\n'; exit 0 ;;
    --reconciliar)
        shift
        reconciliar "${1:-}"
        exit $? ;;
    --planificar)
        shift
        [ -z "${1:-}" ] && { printf 'Uso: bin/ciclo --planificar <id de la tarea que cerró>\n'; exit 1; }
        fase_planificar "$1"
        exit $? ;;
    --estado)
        printf 'Fase actual : %s\n' "$(cat runs/ciclo.estado 2>/dev/null || echo '—')"
        printf 'Cola        : %s\n' "$(tr '\n' ' ' < "$COLA" 2>/dev/null || echo '—')"
        printf 'Rama        : %s\n' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '—')"
        printf 'Parada      : %s\n' "$([ -f "$DETENER" ] && head -1 "$DETENER" || echo 'no')"
        # El prompt de la tarea siguiente queda sin commitear entre vueltas: lo
        # commitea la vuelta que lo va a usar. Conviene verlo acá para no
        # confundirlo con trabajo olvidado.
        pendiente=$(git status --porcelain -- "${PLANIFICACION[@]}" 2>/dev/null | sed -E 's/^.{3}//' | tr '\n' ' ')
        printf 'Planificado : %s\n' "${pendiente:-nada pendiente de commitear}"
        # Lo que el ciclo dejó atrás sin integrar: sigue avanzando, pero esto
        # espera una decisión y si no se mira, no se mira nunca.
        trabadas=""
        for e in runs/[0-9][0-9].estado; do
            [ -f "$e" ] || continue
            v=$(tr -d '[:space:]' < "$e")
            case "$v" in
                BLOQUEADA|RECHAZADA|AGOTADA|INCOMPLETA)
                    trabadas="$trabadas $(basename "$e" .estado):$v" ;;
            esac
        done
        printf 'Trabadas    : %s\n' "${trabadas:-ninguna}"
        [ -n "$trabadas" ] && printf '              (si alguna se integró por otra vía, bin/ciclo --reconciliar lo detecta)\n'
        if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
            printf 'Proceso     : vivo (PID %s)\n' "$(cat "$PID")"
        else
            printf 'Proceso     : no está corriendo\n'
        fi
        printf '\nÚltimas líneas de la bitácora:\n'; tail -12 "$BITACORA" 2>/dev/null
        exit 0 ;;
    --fondo)
        shift
        rm -f "$DETENER"
        CICLO_EN_FONDO=1 nohup "$0" "$@" >> "$BITACORA" 2>&1 &
        echo $! > "$PID"
        printf 'Ciclo corriendo en segundo plano (PID %s).\n' "$(cat "$PID")"
        printf 'Sobrevive a cerrar la terminal. Seguimiento: bin/ciclo --estado · tail -f %s\n' "$BITACORA"
        printf 'Para pararlo: bin/ciclo --detener\n'
        exit 0 ;;
esac

VUELTAS_MAX=0
[ "${1:-}" = "--vueltas" ] && { VUELTAS_MAX="${2:-0}"; shift 2; }

if detencion_pedida; then
    printf 'Hay una parada pedida (%s). Levantala con bin/ciclo --reanudar.\n' "$(head -1 "$DETENER")"
    exit 1
fi

echo $$ > "$PID"
trap 'rm -f "$PID"' EXIT

fase "Ciclo continuo — $(date '+%d/%m %H:%M')"
log "cola inicial: $(tr '\n' ' ' < "$COLA" 2>/dev/null || echo '(vacía)')"

vueltas=0
trabadas=0
while :; do
    if abortar_si_detenido; then break; fi

    id=$(siguiente_id) || { aviso "No queda ninguna tarea pendiente en la cola"; break; }

    vuelta "$id"
    resultado=$?

    case "$resultado" in
        0)
            ok "Tarea $id completa: implementada, verificada, integrada y con la siguiente planificada"
            trabadas=0 ;;
        2)
            aviso "Ciclo detenido en medio de la tarea $id"; break ;;
        3)
            malo "Ciclo detenido: la tarea $id no pudo arrancar. No es la tarea, es el entorno — working tree sucio ajeno al ciclo o develop inalcanzable. Mirá runs/ciclo.log, limpiá y relanzá."; break ;;
        4)
            # Bloqueada: no toca el contador, ni para sumar ni para reiniciar.
            # No se integró, así que no es un éxito que perdone fallos previos;
            # tampoco es evidencia de que algo esté roto, así que no acerca la
            # parada. Queda anotada y el bucle sigue con la próxima.
            aviso "Tarea $id bloqueada: espera una decisión tuya en runs/$id.md. No es un fallo del ciclo — sigo con la próxima." ;;
        *)
            trabadas=$((trabadas + 1))
            malo "La tarea $id no llegó a integrarse ($trabadas seguida(s)). Queda marcada en runs/$id.estado; sigo con la próxima."
            if [ "$trabadas" -ge "$TAREAS_TRABADAS" ]; then
                malo "Ciclo detenido: $TAREAS_TRABADAS tareas seguidas sin integrarse. Algo sistemático está fallando — mirá runs/ciclo.log"
                break
            fi ;;
    esac

    vueltas=$((vueltas + 1))
    if [ "$VUELTAS_MAX" -gt 0 ] && [ "$vueltas" -ge "$VUELTAS_MAX" ]; then
        aviso "Alcanzó el tope de $VUELTAS_MAX vuelta(s) de esta corrida"
        break
    fi
done

fase "Resumen"
while read -r id; do
    [ -z "$id" ] && continue
    case "$id" in \#*) continue ;; esac
    printf '  %-4s %-12s %s\n' "$id" "$(leer_estado "$id")" \
        "$([ -f "runs/$id.pr" ] && echo "PR #$(cat "runs/$id.pr")")"
done < "$COLA" 2>/dev/null

# Lo trabado se cierra seguido por otra vía —un reintento, trabajo a mano— y
# el archivo de estado no se entera. No se reconcilia solo a propósito:
# cambiar un estado sin que nadie mire es justo lo que haría que una tarea sin
# hacer pase por hecha. Acá se avisa; decidir es del usuario.
trabadas_al_cierre=""
for e in runs/[0-9][0-9].estado; do
    [ -f "$e" ] || continue
    case "$(tr -d '[:space:]' < "$e")" in
        AGOTADA|INCOMPLETA|RECHAZADA) trabadas_al_cierre="$trabadas_al_cierre $(basename "$e" .estado)" ;;
    esac
done
[ -n "$trabadas_al_cierre" ] && aviso "Quedan trabadas:$trabadas_al_cierre — si alguna se integró igual, bin/ciclo --reconciliar lo detecta y corrige runs/*.estado"

marcar "ciclo terminado"
