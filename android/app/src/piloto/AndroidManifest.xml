<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HU-62: avisos locales de solicitudes nuevas (flutter_local_notifications).
         Es permiso de tiempo de ejecución en Android 13+; la propia API del
         plugin lo pide (ver NotificadorLocalPlugin.pedirPermiso). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Ubicación del piloto durante un servicio en ejecución: se pide solo
         entonces, con el motivo explicado antes del permiso. Sin servicio en
         segundo plano ni permiso de ubicación permanente. El cliente no la
         declara (ver src/cliente). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- HU-68: linterna de emergencia (torch_light). No se declara
         android.permission.CAMERA: el plugin controla el flash con
         CameraManager.setTorchMode, que Android no exige pedir en runtime
         (no abre la cámara) — ver runs/09.md. `required="false"` para no
         excluir del Play Store los dispositivos sin flash. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false"/>
</manifest>
